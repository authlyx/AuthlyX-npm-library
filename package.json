{
  "name": "authlyx",
  "version": "3.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "tsc -p tsconfig.example.json && node build/examples/main.js",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.0.0"
  },
  "license": "MIT"
}
